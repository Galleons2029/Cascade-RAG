# ------------------------------
# Environment Variables for API service & worker
# ------------------------------

# ------------------------------
# Common Variables
# ------------------------------

# 硅基流动 API
SILICON_KEY=
API_KEY=

# Langfuse
LANGFUSE_SECRET_KEY = 
LANGFUSE_PUBLIC_KEY = 
LANGFUSE_BASE_URL = "https://cloud.langfuse.com"

LLM_MODEL=

# ------------------------------
# PostgreSQL (Docker) Defaults
# ------------------------------
# These are used by data-compose `sql_service`.
# Update for your environment and copy this file to `.env`.
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# If your app builds a DATABASE_URL, this is a common pattern
# Inside Docker network (service-to-service):
POSTGRES_URL=postgresql+psycopg_async://$POSTGRES_USER:$POSTGRES_PASSWORD@sql_service:5432/$POSTGRES_DB
# From host machine (because we map 5433 -> 5432):
# postgresql+psycopg_async://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:5433/$POSTGRES_DB

# Use a domestic mirror for Postgres image to avoid Docker Hub timeouts
# You can switch to other mirrors noted in .env.example if needed
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16

# Defaults used when running locally (Docker services override these internally)
# RABBITMQ_HOST=localhost
# QDRANT_DATABASE_HOST=qdrant

# Logging
ENABLE_PIKA_DEBUG=false
LANGSMITH_API_KEY=
# 说明：清华/阿里常用为“守护进程级镜像加速”，不是镜像前缀。它们通常不能直接写在镜像名里，
# 需要配置 /etc/data/daemon.json 的 registry-mirrors 才会生效（对所有镜像生效）。
# 如果你更偏好清华/阿里源，请按下方注释配置 Docker 守护进程加速后，保持默认镜像名（postgres:16）。
# Default (if not set): postgres:16

# ------------------------------
# Docker 守护进程镜像加速（系统级，可选）
# ------------------------------
# 这部分不是环境变量设置，而是给系统级 Docker 配置的操作指南：
# 1. 编辑 /etc/data/daemon.json（没有就新建）并添加如下内容：
# {
#   "registry-mirrors": [
#     "https://docker.mirrors.tuna.tsinghua.edu.cn",  # 清华源
#     "https://<你的ID>.mirror.aliyuncs.com"            # 阿里云个人/企业加速器，需替换为你的专属地址
#   ]
# }
# 2. 重启 Docker 服务：
#    sudo systemctl daemon-reload && sudo systemctl restart data
# 3. 之后使用默认镜像名即可（例如 postgres:16），拉取会自动走加速。

# ------------------------------
# MinerU API Configuration
# ------------------------------
# MinerU 文档解析服务 API Token
# 在 https://mineru.net 申请
MINERU_API_KEY=
